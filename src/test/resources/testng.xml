<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Тізбекті іске қосу үшін parallel="none" қойыңыз -->
<suite name="PracticeTestAutomation Suite" parallel="methods" thread-count="2">
  <listeners>
    <listener class-name="utils.TestListener"/>
  </listeners>
  <test name="UI tests">
    <classes>
      <class name="tests.LoginTest"/>
      <class name="tests.ExceptionsTest"/>
    </classes>
  </test>
</suite>
